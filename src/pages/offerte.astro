---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferteForm from '../components/OfferteForm.astro';
import TrustPoints from '../components/TrustPoints.astro';
import Bubbles from '../components/Bubbles.astro';
import { site, whatsappUrl, telUrl } from '../config/site';
---
<BaseLayout
  title="Offerte aanvragen: schoonmaak en glasbewassing | F&D"
  description="Vraag vrijblijvend een offerte aan voor schoonmaak of glasbewassing en gevelreiniging in Twente. In 3 korte stappen, antwoord binnen 1 minuut."
  crumbs={[{ name: 'Offerte aanvragen', path: '/offerte/' }]}
  hideStickyBar
>
  <section class="relative overflow-hidden border-b border-line bg-surface">
    <Bubbles tone="light" sparkles={false} />
    <div class="container-page relative py-10 sm:py-14">
      <h1><span class="wipe inline-block">Vraag een offerte aan</span></h1>
      <p class="lead mt-4 text-ink">Vertel ons wat je nodig hebt. Vrijblijvend, in 3 korte stappen. Liever direct contact?</p>
      <p class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-semibold">
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="text-secondary underline">App ons</a>
        <a href={telUrl} class="text-secondary underline">Bel {site.contact.phoneDisplay}</a>
      </p>
      <div class="mt-6"><TrustPoints /></div>
    </div>
  </section>

  <section class="py-10 sm:py-14">
    <div class="container-page">
      <OfferteForm />
    </div>
  </section>
</BaseLayout>

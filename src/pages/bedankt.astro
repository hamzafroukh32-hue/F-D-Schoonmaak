---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../config/site';
---
<BaseLayout title="Bedankt voor uw aanvraag | F&D Schoonmaak" description="Uw aanvraag is verzonden. We reageren binnen 1 minuut." noindex>
  <section class="section">
    <div class="container-page max-w-2xl text-center">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-secondary-soft text-secondary"><Icon name="check" class="h-8 w-8" /></span>
      <h1 class="mt-6">Bedankt, uw aanvraag is binnen</h1>
      <p class="lead mt-4">We reageren {site.responseTime}. Houd uw telefoon of mailbox in de gaten.</p>
      <p class="mt-4 text-muted">Wilt u nog iets toevoegen, zoals een extra foto? Stuur het gerust via WhatsApp.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href={whatsappUrl('Hallo F&D Schoonmaak, ik heb net het formulier ingevuld. Hierbij nog een foto: ')} variant="whatsapp" icon="whatsapp" external>Stuur foto via WhatsApp</Button>
        <Button href="/" variant="outline">Terug naar home</Button>
      </div>
    </div>
  </section>
</BaseLayout>

---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TrustPoints from '../../components/TrustPoints.astro';
import Steps from '../../components/Steps.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import OfferteCta from '../../components/OfferteCta.astro';
import { getCollection } from 'astro:content';
import { actieveDiensten, isGlas, type Dienst } from '../../data/diensten';
import { glasFeiten } from '../../lib/glas';
import { projectenMetFoto } from '../../data/projecten';
const heeftGlasFotos = projectenMetFoto.some((p) => p.categorie === 'glas');
import { plaatsen } from '../../data/plaatsen';
import { faqSchema, serviceSchema } from '../../lib/schema';
import { withPlaceholders, stripPlaceholders } from '../../lib/text';
import { whatsappUrl } from '../../config/site';

export const getStaticPaths = (() => actieveDiensten.map((d) => ({ params: { slug: d.slug }, props: { dienst: d } }))) satisfies GetStaticPaths;

const { dienst } = Astro.props as { dienst: Dienst };
const u = dienst.aanspreek === 'u';
const path = `/diensten/${dienst.slug}/`;
const waText = `Hallo F&D Schoonmaak, ik wil graag een prijs voor: ${dienst.h1.toLowerCase()}. `;
const anderen = actieveDiensten.filter((d) => d.slug !== dienst.slug);
const glas = isGlas(dienst);
const offerteHref = `/offerte/?dienst=${glas ? 'glas' : dienst.slug === 'eindschoonmaak-diepteschoonmaak' ? 'diep' : 'schoonmaak'}${dienst.doelgroep === 'zakelijk' ? '&voor=zakelijk' : ''}`;
const glasVarianten = actieveDiensten.filter(isGlas);
const plaatsLink = (slug: string) => (glas ? `/werkgebied/${slug}/glazenwasser/` : `/werkgebied/${slug}/`);
const artikelen = (await getCollection('kennisbank')).filter((a) => a.data.dienst === dienst.slug || (glas && isGlas({ slug: a.data.dienst })));
---
<BaseLayout
  title={dienst.title}
  description={dienst.description}
  crumbs={[{ name: 'Diensten', path: '/diensten/' }, { name: dienst.kort, path }]}
  schemas={[serviceSchema(dienst.h1, stripPlaceholders(dienst.intro[0]), path), faqSchema(dienst.faq)]}
>
  <PageHero kicker={u ? 'Zakelijk' : 'Particulier'} title={dienst.h1} intro={dienst.intro} waText={waText}>
    {glas && (
      <nav aria-label="Glasbewassing voor" class="mt-8 inline-flex rounded-full border border-line-strong bg-paper p-1">
        {glasVarianten.map((v) => (
          <a href={`/diensten/${v.slug}/`} aria-current={v.slug === dienst.slug ? 'page' : undefined} class:list={['min-h-11 rounded-full px-5 py-2.5 font-semibold no-underline', v.slug === dienst.slug ? 'bg-primary text-white' : 'text-primary hover:bg-surface']}>
            {v.doelgroep === 'particulier' ? 'Particulier' : 'Zakelijk'}
          </a>
        ))}
      </nav>
    )}
    <div class="mt-8"><TrustPoints /></div>
  </PageHero>

  <section class="section" aria-labelledby="inbegrepen">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 id="inbegrepen">Wat is inbegrepen</h2>
        <p class="mt-3 text-muted">{u ? 'Standaard bij elke beurt. Wilt u iets toevoegen of weglaten? Dat stemmen we vooraf af.' : 'Dit doen we standaard. Wil je iets extra? Zeg het vooraf, dan nemen we het mee in de prijs.'}</p>
        <ul class="mt-6 space-y-3">
          {dienst.inbegrepen.map((item) => (
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-secondary" />
              <span set:html={withPlaceholders(item)} />
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl">Voor wie</h2>
        <ul class="mt-6 border-t border-line">
          {dienst.voorWie.map((v) => <li class="border-b border-line py-3 font-medium">{v}</li>)}
        </ul>
        {glas && (
          <dl class="mt-8 grid gap-x-6 gap-y-3 rounded-card bg-surface p-5 sm:grid-cols-[8rem_1fr]">
            {glasFeiten.map((f) => (
              <>
                <dt class="font-semibold text-primary">{f.label}</dt>
                <dd set:html={withPlaceholders(f.value)} />
              </>
            ))}
          </dl>
        )}
        <div class="mt-8 rounded-card bg-primary p-6 text-white">
          <p class="font-display text-xl font-bold">{u ? 'Wilt u direct een prijs?' : 'Wil je direct een prijs?'}</p>
          <p class="mt-2 text-white/85">{glas ? (u ? 'Stuur een paar foto’s van de gevel.' : 'Stuur je type woning of een foto van de voor- en achterkant.') : u ? 'Stuur een foto van de ruimte en het aantal m².' : 'Stuur een foto en het aantal m².'}</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <Button href={whatsappUrl(waText)} variant="whatsapp" icon="whatsapp" external data-cta="dienst-whatsapp">App ons</Button>
            <Button href={offerteHref} variant="accent" data-cta="dienst-offerte">Offerte aanvragen</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {dienst.checklist && (
    <section class="section bg-surface" aria-labelledby="checklist">
      <div class="container-page">
        <div class="max-w-2xl">
          <h2 id="checklist">{dienst.checklist.titel}</h2>
          <p class="lead mt-4" set:html={withPlaceholders(dienst.checklist.intro)} />
        </div>
        <div class="mt-10 grid overflow-hidden rounded-card border border-line-strong bg-paper sm:grid-cols-2 lg:grid-cols-4">
          {dienst.checklist.groepen.map((g) => (
            <div class="border-b border-line p-6 sm:border-r last:border-b-0">
              <h3>{g.naam}</h3>
              <ul class="mt-4 space-y-2 text-[0.95rem]">
                {g.items.map((i) => (
                  <li class="flex gap-2"><span class="mt-1 text-secondary" aria-hidden="true">☐</span><span>{i}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="werkwijze">
    <div class="container-page">
      <h2 id="werkwijze">Zo pakken we het aan</h2>
      <div class="mt-10">
        <Steps steps={dienst.werkwijze.slice(0, 3)} />
      </div>
      {dienst.werkwijze[3] && (
        <p class="mt-6 max-w-2xl text-muted"><strong class="text-primary">{dienst.werkwijze[3].titel}.</strong> {dienst.werkwijze[3].tekst}</p>
      )}
    </div>
  </section>


  <section class="section" aria-label="Prijs berekenen">
    <div class="container-page max-w-3xl">
      <OfferteCta dienst={glas ? 'glas' : dienst.slug === 'eindschoonmaak-diepteschoonmaak' ? 'diep' : 'schoonmaak'} voor={dienst.doelgroep === 'zakelijk' ? 'zakelijk' : 'woning'} />
    </div>
  </section>

  <section class="section" aria-labelledby="plaatsen">
    <div class="container-page">
      <h2 id="plaatsen" class="text-2xl sm:text-3xl">{dienst.kort} in {u ? 'uw' : 'jouw'} regio</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {plaatsen.map((p) => (
          <li>
            <a href={plaatsLink(p.slug)} class="inline-flex min-h-11 items-center rounded-full border border-line px-4 py-2 font-medium text-primary no-underline hover:border-secondary hover:text-secondary">
              {dienst.zoekwoordPlaats} {p.naam}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-surface" aria-label="Veelgestelde vragen">
    <div class="container-page max-w-3xl">
      <FaqList faqs={dienst.faq} title={`Vragen over ${dienst.kort.toLowerCase()}`} />
      {artikelen.length > 0 && (
        <div class="mt-10">
          <h2 class="text-[1.75rem]">Lees ook</h2>
          <ul class="mt-4 space-y-2">
            {artikelen.map((a) => <li><a href={`/kennisbank/${a.id}/`} class="font-semibold text-secondary underline">{a.data.h1}</a></li>)}
            {glas && heeftGlasFotos && <li><a href="/projecten/?categorie=glas" class="font-semibold text-secondary underline">Bekijk voor en na van ramen</a></li>}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="section pb-0" aria-labelledby="andere">
    <div class="container-page">
      <h2 id="andere" class="text-2xl sm:text-3xl">Andere diensten</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {anderen.map((d) => <li><a href={`/diensten/${d.slug}/`} class="font-semibold text-secondary">{d.h1}</a></li>)}
      </ul>
    </div>
  </section>

  <CtaBlock aanspreek={dienst.aanspreek} waText={waText} />
</BaseLayout>

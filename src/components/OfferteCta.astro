---
// Button into the /offerte/ request form, preselected. Prices live on /prijzen/.
import Button from './Button.astro';

interface Props {
  dienst?: 'glas' | 'schoonmaak' | 'diep';
  voor?: 'woning' | 'zakelijk';
}
const { dienst = 'glas', voor = 'woning' } = Astro.props;
const href = `/offerte/?dienst=${dienst}${voor === 'zakelijk' ? '&voor=zakelijk' : ''}`;
const u = voor === 'zakelijk';
---
<div class="flex flex-col gap-6 rounded-card bg-primary p-6 text-white sm:flex-row sm:items-center sm:p-8" id="prijs-berekenen">
  <div class="flex-1">
    <h2 class="text-[2rem] text-white">Offerte op maat</h2>
    <p class="mt-2 text-white/85">
      {dienst === 'glas'
        ? u
          ? 'Vertel ons over uw pand en ontvang een vrijblijvende offerte.'
          : 'Vertel ons over je woning en ontvang een vrijblijvende offerte.'
        : u
          ? 'Vertel ons wat er schoon moet en ontvang een vrijblijvende offerte.'
          : 'Vertel ons wat er schoon moet en ontvang een vrijblijvende offerte.'}
    </p>
  </div>
  <Button href={href} variant="accent" size="lg" data-cta={`offerte-${dienst}`}>Offerte aanvragen</Button>
</div>

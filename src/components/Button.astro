---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'accent' | 'whatsapp' | 'primary' | 'outline' | 'ghost-light';
  size?: 'md' | 'lg';
  icon?: IconName;
  class?: string;
  external?: boolean;
  pulse?: boolean; // soft attention ring (use once per page at most)
  'data-cta'?: string;
}
const { href, variant = 'accent', size = 'md', icon, class: className = '', external = false, pulse = false, ...rest } = Astro.props;

const base = 'btn inline-flex min-h-12 items-center justify-center gap-2 rounded-button font-semibold no-underline';
const sizes = { md: 'px-5 py-3 text-base', lg: 'px-6 py-4 text-lg' };
const variants = {
  accent: 'btn-shine bg-accent text-accent-ink hover:bg-accent-hover',
  whatsapp: 'btn-shine bg-whatsapp text-white hover:bg-whatsapp-hover',
  primary: 'bg-primary text-white hover:bg-primary-soft',
  outline: 'border-2 border-primary text-primary hover:bg-primary hover:text-white',
  'ghost-light': 'border-2 border-white/70 text-white hover:bg-white hover:text-primary',
};
---
<a
  href={href}
  class:list={[base, sizes[size], variants[variant], pulse && 'btn-pulse', className]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  {icon && <Icon name={icon} class="relative h-5 w-5 shrink-0" />}
  <span class="relative"><slot /></span>
</a>

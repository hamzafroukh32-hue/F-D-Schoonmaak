---
// Brand logo (src/assets/brand/logo.png, generated by scripts/logo.mjs from logo-bron.webp).
import { Picture } from 'astro:assets';
import logo from '../assets/brand/logo.png';

interface Props {
  size?: 'header' | 'footer';
  eager?: boolean;
}
const { size = 'header', eager = false } = Astro.props;
// Rendered heights in CSS px; the image is served at 2x for sharp screens.
const h = size === 'header' ? 76 : 88;
const w = Math.round((logo.width / logo.height) * h);
const sizeClass = size === 'header' ? 'h-[56px] lg:h-[70px]' : 'h-[88px]';
---
<Picture
  src={logo}
  alt="F&D Schoonmaak"
  width={w}
  height={h}
  widths={[w, w * 2]}
  sizes={`${w}px`}
  formats={['avif', 'webp']}
  loading={eager ? 'eager' : 'lazy'}
  class:list={['logo block w-auto max-w-none', sizeClass]}
/>

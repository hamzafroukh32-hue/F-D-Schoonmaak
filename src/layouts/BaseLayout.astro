---
import '../styles/global.css';
import { site, absoluteUrl } from '../config/site';
import { businessSchema, breadcrumbSchema, type Crumb } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  crumbs?: Crumb[]; // excluding Home; Home is added automatically
  schemas?: (Record<string, unknown> | null)[];
  ogType?: 'website' | 'article';
  hideStickyBar?: boolean; // e.g. on /offerte/, which has its own sticky price bar
}

const { title, description, noindex = false, crumbs = [], schemas = [], ogType = 'website', hideStickyBar = false } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl('/og-default.png');
const allCrumbs: Crumb[] = crumbs.length ? [{ name: 'Home', path: '/' }, ...crumbs] : [];

const jsonLd = [businessSchema(), allCrumbs.length ? breadcrumbSchema(allCrumbs) : null, ...schemas].filter(Boolean);
const { analytics } = site;
---
<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#043168" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      // Mark JS as available before first paint, so scroll reveals only hide content when they can show it again.
      document.documentElement.classList.add('js');
      // Remember first landing page, referrer and UTM params for the quote form (session only).
      try {
        const k = 'fd_tracking';
        const utm = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        const q = new URLSearchParams(location.search);
        let d = JSON.parse(sessionStorage.getItem(k) || 'null');
        if (!d || utm.some((u) => q.get(u))) {
          d = d || { landingspagina: location.pathname + location.search, verwijzer: document.referrer };
          utm.forEach((u) => { if (q.get(u)) d[u] = q.get(u); });
          sessionStorage.setItem(k, JSON.stringify(d));
        }
      } catch {
        // storage unavailable (private mode): form still works without tracking
      }
    </script>

    {
      analytics.provider === 'plausible' && (
        <script is:inline defer data-domain={analytics.plausibleDomain} src="https://plausible.io/js/script.js" />
      )
    }
    {
      analytics.provider === 'umami' && analytics.umamiSrc && (
        <script is:inline defer src={analytics.umamiSrc} data-website-id={analytics.umamiWebsiteId} />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#inhoud"
      class="sr-only z-50 rounded-lg bg-accent px-4 py-2 font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Naar de inhoud</a
    >
    <Header />
    {allCrumbs.length > 0 && <Breadcrumbs crumbs={allCrumbs} />}
    <main id="inhoud" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideStickyBar && <StickyMobileBar />}
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
